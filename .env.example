# Copy to .env (gitignored) and fill in. Sourced by script_train/_common.sh.
# Everything is optional — leave blank to disable that feature.

# ----- Weights & Biases (training metric logging) -----
# Set WANDB_API_KEY to enable; otherwise training falls back to --report_to none.
WANDB_API_KEY=
WANDB_PROJECT=vlm-distillation-may22
# Optional: org/user that owns the project. Defaults to your wandb default entity.
WANDB_ENTITY=
# Prefix prepended to RUN_NAME for the wandb run display name. e.g. "phase0-".
WANDB_NAME_PREFIX=phase0-

# ----- Hugging Face Hub (checkpoint push) -----
# Set HF_TOKEN and HF_HUB_REPO_PREFIX together to enable --push_to_hub.
# Full repo id will be ${HF_HUB_REPO_PREFIX}${RUN_NAME}, e.g. "vukienaarista/qwen25_teacher_7b_qwen2_student_2b_unit_aligned_ds2".
HF_TOKEN=
HF_HUB_REPO_PREFIX=
# Set to "false" to create public repos. Default is private.
HF_HUB_PRIVATE=true
# HF Trainer push frequency: "end" (only after train) or "every_save" (after each save).
HF_HUB_STRATEGY=every_save
